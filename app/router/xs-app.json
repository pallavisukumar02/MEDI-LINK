{
  "welcomeFile": "/index.html",
  "authenticationMethod": "route",
  "logout": { "logoutEndpoint": "/do/logout", "logoutPage": "/index.html" },
  "websockets": { "enabled": true },
  "routes": [
    { "source": "^/me/(.*)$", "target": "/me/$1", "destination": "srv-api", "authenticationType": "xsuaa" },
    { "source": "^/ws/(.*)$", "target": "/ws/$1", "destination": "srv-api", "authenticationType": "xsuaa" },
    { "source": "^/odata/(.*)$", "target": "/odata/$1", "destination": "srv-api", "authenticationType": "xsuaa" },
    { "source": "^/(onboarding|sync|audit)/(.*)$", "target": "/$1/$2", "destination": "srv-api", "authenticationType": "xsuaa" },
    { "source": "^/health/integrations$", "target": "/health/integrations", "destination": "srv-api", "authenticationType": "xsuaa" },
    { "source": "^/admin/metrics$", "target": "/admin/metrics", "destination": "srv-api", "authenticationType": "xsuaa" },
    { "source": "^/(.*)$", "target": "$1", "localDir": "resources", "authenticationType": "xsuaa" }
  ]
}
