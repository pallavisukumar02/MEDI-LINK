{
  "name": "medilink-backend",
  "version": "1.0.0",
  "private": true,
  "description": "MediLink CAP backend (SAP Hackfest 2026 prototype): SQLite, MediLink accounts",
  "dependencies": {
    "@cap-js-community/websocket": "^1",
    "@cap-js/sqlite": "^3",
    "@sap-ai-sdk/foundation-models": "^2.17.0",
    "@sap/cds": "^10",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16",
    "express": "^4",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^10.3.1",
    "pdf-parse": "^1.1.4"
  },
  "devDependencies": {
    "@cap-js/cds-test": "^1",
    "axios": "^1",
    "jest": "^29"
  },
  "scripts": {
    "start": "cds-serve",
    "watch": "cds watch",
    "test": "jest --runInBand",
    "test:unit": "jest --runInBand test/cover.test.js test/rules.test.js test/routing.test.js test/audit-chain.test.js"
  },
  "jest": {
    "testTimeout": 60000,
    "testEnvironment": "node",
    "forceExit": true
  },
  "cds": {
    "requires": {
      "db": {
        "kind": "sqlite",
        "credentials": {
          "url": "db/medilink.sqlite"
        },
        "[test]": {
          "credentials": {
            "url": ":memory:"
          }
        }
      },
      "auth": {
        "kind": "custom",
        "impl": "srv/auth.js"
      },
      "websocket": {
        "kind": "ws"
      }
    },
    "server": {
      "body_parser": {
        "limit": "8mb"
      }
    }
  },
  "engines": {
    "node": ">=22.12"
  }
}
