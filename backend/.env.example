# =====================================================================
# MediLink backend - environment template
# Copy to backend/.env and fill in. NEVER commit backend/.env.
# SAP service credentials (HANA, XSUAA, Destination, AI Core) are NOT
# kept here: bind them with `cds bind` (see SETUP_CHECKLIST.md step 6),
# which writes them to .cdsrc-private.json (also git-ignored).
# =====================================================================

# ---------- App ----------
NODE_ENV=development
PORT=4004                           # CAP listens here (hosts usually set PORT for you)
APP_BASE_URL=http://localhost:4004  # public URL of CAP (links in emails, connector set-up page)
# Profile for `cds watch` / hybrid work: "development" = SQLite in-memory, "hybrid" = real HANA Cloud via cds bind
CDS_ENV=development

# =====================================================================
# STANDALONE MODE (no SAP BTP at all) - npm run db:init, npm run start:standalone
# Check what is missing with: npm run env:check
# Make random values with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# =====================================================================
# Which standalone profile the npm scripts use: standalone (SQLite file) | standalone-pg (PostgreSQL)
# On a hosting service set CDS_ENV to the same value instead (CAP reads CDS_ENV).
CDS_PROFILE=standalone
# PostgreSQL (standalone-pg only): connection string from your hosted PostgreSQL. SSL is always on;
# add ?sslmode=no-verify only if the host uses a self-signed certificate.
DATABASE_URL=
# Logins (replaces XSUAA): signs the login tokens. At least 32 random characters. Changing it signs everyone out.
AUTH_JWT_SECRET=change-me-random-64-hex
# How long a login lasts: 30m, 8h, 2d ... (default 8h)
AUTH_JWT_TTL=8h
# Password of the demo users (asha, ravi, meera, kiran, partner, admin, ...) created by npm run db:init. At least 8 characters.
DEMO_PASSWORD=change-me-demo-password
# Hospital OAuth tokens (replaces the Destination service): AES-256-GCM key, at least 32 random characters.
# Keep it stable: if it changes, hospitals must press "Connect" again.
TOKEN_ENCRYPTION_KEY=change-me-random-64-hex
# Email alerts (replaces SAP Alert Notification). Off while SMTP_HOST is empty.
# Sent for: new shortfall, temperature out of range, recall, licence expiring, stale stock feed.
SMTP_HOST=
SMTP_PORT=587                       # 465 = SSL, 587 = STARTTLS
SMTP_USER=
SMTP_PASS=
ALERT_EMAIL_FROM=                   # e.g. MediLink <alerts@your-domain>
# ALERT_EMAIL_TO (below, under Alerts) = who receives them, comma separated

# ---------- SAP BTP account (for reference / CLI scripts) ----------
BTP_GLOBAL_ACCOUNT_SUBDOMAIN=
BTP_SUBACCOUNT_SUBDOMAIN=
BTP_REGION=us10                     # e.g. us10, eu10, ap21 - the region your trial/free tier is in
CF_API_ENDPOINT=https://api.cf.us10-001.hana.ondemand.com
CF_ORG=
CF_SPACE=dev

# ---------- SAP HANA Cloud (names only; credentials come via cds bind) ----------
HANA_INSTANCE_NAME=medilink-hana    # the HANA Cloud instance you created in the BTP cockpit
HDI_CONTAINER_SERVICE=medilink-db   # cf service name of the hdi-shared container

# ---------- SAP Business Accelerator Hub (sandbox - "SAP hospital") ----------
# Get the key at api.sap.com -> log in -> Settings -> Show API Key
SAP_API_HUB_KEY=
SAP_API_HUB_SANDBOX_BASE=https://sandbox.api.sap.com/s4hanacloud
# Paths the agent will use (verify on api.sap.com before running):
SAP_API_MATERIAL_STOCK_PATH=/sap/opu/odata/sap/API_MATERIAL_STOCK_SRV
SAP_API_BATCH_PATH=/sap/opu/odata4/sap/api_batch/srvd_a2x/sap/batch/0001

# ---------- Mock partner HIS "MediSoft" (OAuth 2.0 server the agent builds) ----------
MEDISOFT_BASE_URL=http://localhost:4100
MEDISOFT_OAUTH_CLIENT_ID=medilink-client
MEDISOFT_OAUTH_CLIENT_SECRET=change-me-random-32-chars
MEDISOFT_OAUTH_REDIRECT_URI=http://localhost:4004/oauth/medisoft/callback
MEDISOFT_SCOPES=stock.read schedule.read
# mock-medisoft only: its own port and the CAP callback URLs it accepts (comma separated)
# MEDISOFT_PORT=4100
# MEDISOFT_ALLOWED_REDIRECTS=http://localhost:4004/oauth/medisoft/callback

# ---------- In-house DB connector (local PostgreSQL = "Hospital C pharmacy") ----------
CONNECTOR_DB_URL=sqlite:///connector/hospital_c.db   # any SQLAlchemy URL: postgresql://, mysql+pymysql://, mssql+pyodbc://
CONNECTOR_INGEST_URL=http://localhost:4004/ingest
CONNECTOR_SYNC_INTERVAL_SEC=900
# Pairing codes are issued by CAP at runtime; this only salts them
CONNECTOR_PAIRING_SECRET=change-me-random-32-chars

# ---------- Matching service (Python + OR-Tools) ----------
MATCHER_URL=http://localhost:5001  # where CAP finds the matcher (on a Python host: its public URL)
MATCHER_TIMEOUT_MS=10000
MATCHER_TOKEN=                      # shared secret; set the same value on the matcher host when deployed

# ---------- Routing and weather (free) ----------
# openrouteservice.org -> sign up -> Dashboard -> request a free token
ORS_API_KEY=
ORS_BASE_URL=https://api.openrouteservice.org
# Open-Meteo needs no key
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast

# ---------- LLM ----------
# none = templates only (default; everything works). aicore = SAP AI Core (BTP profiles only; ignored in standalone).
# openai-compatible = any OpenAI-style chat API, e.g. a free tier (check the provider's current free-tier limits).
LLM_PROVIDER=none                    # none | aicore | openai-compatible
LLM_BASE_URL=                        # openai-compatible: base URL ending before /chat/completions, e.g. https://api.example.com/v1
LLM_API_KEY=                         # openai-compatible: API key (sent as Bearer token)
LLM_MODEL=                           # openai-compatible: model name
AICORE_RESOURCE_GROUP=default
AICORE_MODEL_NAME=                   # a model your generative AI hub trial lists, e.g. gpt-4o-mini
AICORE_SERVICE_KEY_PATH=./aicore-key.json   # downloaded service key; git-ignored
# If LLM_PROVIDER=none, the app must still work (template explanations, manual flag entry)

# ---------- Alerts ----------
ALERT_NOTIFICATION_ENABLED=false     # true once SAP Alert Notification is bound (BTP profiles only)
ALERT_EMAIL_TO=                      # recipients for Alert Notification or SMTP email, comma separated
# Approvals: cap = built-in (always in standalone) | bpa = SAP Build Process Automation (BTP)
APPROVAL_MODE=cap
# Demo only: count seeded hospitals as freshly synced at start-up. Set false for real hospitals.
DEMO_FRESH_SEED=true

# ---------- Business rules (defaults, overridable per hospital) ----------
DEFAULT_SAFETY_MARGIN_PCT=20
DEFAULT_COVER_WINDOW_DAYS=14
EXPIRY_BUFFER_DAYS=7
NEAR_EXPIRY_DAYS=60
SUPPLIER_RESPONSE_TIMEOUT_MIN=30
SYNC_INTERVAL_SEC=900
STALE_FEED_MINUTES=60
COLD_CHAIN_MIN_C=2
COLD_CHAIN_MAX_C=8
PATIENT_REF_HASH_SALT=change-me-random-32-chars

# ---------- Delivery partner simulator ----------
SIM_TELEMETRY_INTERVAL_SEC=5
SIM_EXCURSION_ENABLED=true           # one shipment deliberately goes out of range
