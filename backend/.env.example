# =====================================================================
# MediLink backend - environment template (prototype, synthetic data)
# Development: npm run dev creates backend/.env from this file on first run, with fresh random secrets.
# Production:  copy this file to backend/.env (or set the variables on your host) and replace every change-me value.
# NEVER commit backend/.env. Check it any time with: npm run env:check (prints names, never values)
# Make a random value: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Keep comments on their own lines: CAP also reads this file and keeps a "# comment" after a value as part of the value.
# =====================================================================

# ---------- App ----------
# CAP listens here (hosts usually set PORT for you)
PORT=4004
# public URL of CAP (links in emails, connector set-up page)
APP_BASE_URL=http://localhost:4004
# behind a reverse proxy: number of proxy hops (usually 1) or the proxy IPs/CIDRs, so rate limits see the client IP. Empty = off
TRUST_PROXY=
# Database: the SQLite file backend/db/medilink.sqlite (npm run db:init / npm run db:reset). Nothing to set.

# ---------- Logins: MediLink accounts (required) ----------
# signs login tokens: 32+ random characters; changing it signs everyone out
AUTH_JWT_SECRET=change-me-random-64-hex
# how long a login lasts: 30m, 8h, 2d ...
AUTH_JWT_TTL=8h
# Password of the demo users (asha, ravi, meera, kiran, partner, admin, ...) that npm run db:init creates.
# npm run dev sets "demo"; in production use 8+ characters. Production never creates demo users by itself.
DEMO_PASSWORD=change-me-demo-password

# ---------- Hospital connections ----------
# Required: AES-256-GCM key for the hospitals' OAuth tokens, 32+ random characters.
# Keep it stable: if it changes, hospitals must press "Connect" again.
TOKEN_ENCRYPTION_KEY=change-me-random-64-hex
# Salt for SHA-256 patient refs, hashed at the source (same value for MediSoft and the connector)
PATIENT_REF_HASH_SALT=change-me-random-32-chars

# Mock partner HIS "MediSoft" (OAuth 2.0 server)
MEDISOFT_BASE_URL=http://localhost:4100
MEDISOFT_OAUTH_CLIENT_ID=medilink-client
MEDISOFT_OAUTH_CLIENT_SECRET=change-me-random-32-chars
MEDISOFT_OAUTH_REDIRECT_URI=http://localhost:4004/oauth/medisoft/callback
MEDISOFT_SCOPES=stock.read schedule.read
# mock-medisoft only: its own port and the CAP callback URLs it accepts (comma separated)
# MEDISOFT_PORT=4100
# MEDISOFT_ALLOWED_REDIRECTS=http://localhost:4004/oauth/medisoft/callback

# In-house DB connector ("Hospital C pharmacy"; demo = SQLite file)
# any SQLAlchemy URL: postgresql://, mysql+pymysql://, mssql+pyodbc://
CONNECTOR_DB_URL=sqlite:///connector/hospital_c.db
CONNECTOR_INGEST_URL=http://localhost:4004/ingest
CONNECTOR_SYNC_INTERVAL_SEC=900
# pairing codes are issued at runtime; this only salts them
CONNECTOR_PAIRING_SECRET=change-me-random-32-chars

# SAP Business Accelerator Hub sandbox ("SAP hospital" data source; offline copy while the key is empty)
# Get the key at api.sap.com -> log in -> Settings -> Show API Key
SAP_API_HUB_KEY=
SAP_API_HUB_SANDBOX_BASE=https://sandbox.api.sap.com/s4hanacloud
SAP_API_MATERIAL_STOCK_PATH=/sap/opu/odata/sap/API_MATERIAL_STOCK_SRV
SAP_API_BATCH_PATH=/sap/opu/odata4/sap/api_batch/srvd_a2x/sap/batch/0001

# ---------- Matching service (Python + OR-Tools) ----------
# where CAP finds the matcher (on a Python host: its public URL)
MATCHER_URL=http://localhost:5001
MATCHER_TIMEOUT_MS=10000
# shared secret; set the same value on the matcher host when deployed (with NODE_ENV=production the matcher refuses requests without it)
MATCHER_TOKEN=
# address python app.py listens on: 127.0.0.1 = only this machine; 0.0.0.0 when the matcher runs on its own host
MATCHER_HOST=127.0.0.1

# ---------- Routing and weather (free) ----------
# openrouteservice.org free token; empty = straight line x road factor
ORS_API_KEY=
ORS_BASE_URL=https://api.openrouteservice.org
# road shapes for the live map without a key (OSRM; the public demo server is for light use); empty = straight line
OSRM_URL=https://router.project-osrm.org
# no key needed
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast
# live tracking: the courier counts as "nearby" this close to the receiving hospital (km)
NEARBY_KM=1
# hard expiry of a courier link (couriers have no account; one link per delivery, revoked at cancel / recall / reissue)
COURIER_LINK_TTL_HOURS=24

# ---------- Alerts (always in the app; email and SAP Alert Notification are optional) ----------
# Email over SMTP, off while SMTP_HOST is empty. Sent for: new shortfall, low / out of stock, expiring / expired lots,
# temperature out of range, recall, licence expiring, stale stock feed. Each hospital's alerts go to its own pharmacists
# and approvers that set an email (else the hospital's admin email, else ALERT_EMAIL_TO), one digest per check.
SMTP_HOST=
# 465 = SSL, 587 = STARTTLS
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# e.g. MediLink <alerts@your-domain>
ALERT_EMAIL_FROM=
# fallback recipients (ops list), comma separated: hospitals with no email on file, partner licence reminders
ALERT_EMAIL_TO=
# Optional SAP Alert Notification (every alert), off while ALERT_NOTIFICATION_URL is empty. Values from its service key.
ALERT_NOTIFICATION_URL=
ALERT_NOTIFICATION_CLIENT_ID=
ALERT_NOTIFICATION_CLIENT_SECRET=

# ---------- AI (optional; everything works with none) ----------
# none | openai-compatible | aicore
LLM_PROVIDER=none
# openai-compatible: base URL ending before /chat/completions, e.g. https://api.example.com/v1
LLM_BASE_URL=
# openai-compatible: API key (sent as Bearer token)
LLM_API_KEY=
# openai-compatible: model name
LLM_MODEL=
# aicore: downloaded SAP AI Core service key (git-ignored)
AICORE_SERVICE_KEY_PATH=./aicore-key.json
# aicore: a model your generative AI hub deployment runs, e.g. gpt-4o-mini
AICORE_MODEL_NAME=
AICORE_RESOURCE_GROUP=default
# Price vs distance (docs/PRICING.md), synthetic INR. Courier quote per storage class "CLASS:baseFee:perKm"
DELIVERY_RATES=AMBIENT:150:12,COLD:350:22,FROZEN:500:30
# discount on batches inside the near-expiry window (NEAR_EXPIRY_DAYS), in percent
NEAR_EXPIRY_DISCOUNT_PCT=10
# Agents (docs/AGENTS.md): copilot, plan review, delivery watchtower, intake helper. With LLM_PROVIDER=none they run
# on rules only. false = turn every agent off (no AI buttons, no suggestions).
AGENTS_ENABLED=true
# most tool calls one agent run may make before MediLink falls back to its rules answer
AGENT_MAX_STEPS=6

# ---------- Approvals ----------
# cap = built-in (default) | bpa = optional SAP Build Process Automation
APPROVAL_MODE=cap
# bpa only: values from the SAP Build Process Automation service key
BPA_API_URL=
BPA_DEFINITION_ID=
BPA_TOKEN_URL=
BPA_CLIENT_ID=
BPA_CLIENT_SECRET=

# ---------- Business rules (defaults, overridable per hospital) ----------
DEFAULT_SAFETY_MARGIN_PCT=20
DEFAULT_COVER_WINDOW_DAYS=14
EXPIRY_BUFFER_DAYS=7
NEAR_EXPIRY_DAYS=60
# expiry alert tiers in days: one alert per lot for the tightest tier reached, plus one when it has expired
EXPIRY_ALERT_DAYS=90,60,30,7
SUPPLIER_RESPONSE_TIMEOUT_MIN=30
SYNC_INTERVAL_SEC=900
STALE_FEED_MINUTES=60
COLD_CHAIN_MIN_C=2
COLD_CHAIN_MAX_C=8

# ---------- Demo ----------
# count seeded hospitals as freshly synced at start-up (development only)
DEMO_FRESH_SEED=true
# courier simulator: lists the courier links as an admin (SIM_USER / SIM_PASSWORD, default admin / DEMO_PASSWORD)
SIM_TELEMETRY_INTERVAL_SEC=5
# one shipment deliberately goes out of range
SIM_EXCURSION_ENABLED=true
