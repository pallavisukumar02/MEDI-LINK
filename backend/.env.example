# =====================================================================
# MediLink backend - environment template
# Copy to backend/.env and fill in. NEVER commit backend/.env.
# SAP service credentials (HANA, XSUAA, Destination, AI Core) are NOT
# kept here: bind them with `cds bind` (see SETUP_CHECKLIST.md step 6),
# which writes them to .cdsrc-private.json (also git-ignored).
# =====================================================================

# ---------- App ----------
NODE_ENV=development
PORT=4004
APP_BASE_URL=http://localhost:4004
# Profile: "development" = SQLite in-memory, "hybrid" = real HANA Cloud via cds bind
CDS_ENV=development

# ---------- SAP BTP account (for reference / CLI scripts) ----------
BTP_GLOBAL_ACCOUNT_SUBDOMAIN=
BTP_SUBACCOUNT_SUBDOMAIN=
BTP_REGION=us10                     # e.g. us10, eu10, ap21 - the region your trial/free tier is in
CF_API_ENDPOINT=https://api.cf.us10-001.hana.ondemand.com
CF_ORG=
CF_SPACE=dev

# ---------- SAP HANA Cloud (names only; credentials come via cds bind) ----------
HANA_INSTANCE_NAME=medilink-hana    # the HANA Cloud instance you created in the BTP cockpit
HDI_CONTAINER_SERVICE=medilink-db   # cf service name of the hdi-shared container

# ---------- SAP Business Accelerator Hub (sandbox - "SAP hospital") ----------
# Get the key at api.sap.com -> log in -> Settings -> Show API Key
SAP_API_HUB_KEY=
SAP_API_HUB_SANDBOX_BASE=https://sandbox.api.sap.com/s4hanacloud
# Paths the agent will use (verify on api.sap.com before running):
SAP_API_MATERIAL_STOCK_PATH=/sap/opu/odata/sap/API_MATERIAL_STOCK_SRV
SAP_API_BATCH_PATH=/sap/opu/odata4/sap/api_batch/srvd_a2x/sap/batch/0001

# ---------- Mock partner HIS "MediSoft" (OAuth 2.0 server the agent builds) ----------
MEDISOFT_BASE_URL=http://localhost:4100
MEDISOFT_OAUTH_CLIENT_ID=medilink-client
MEDISOFT_OAUTH_CLIENT_SECRET=change-me-random-32-chars
MEDISOFT_OAUTH_REDIRECT_URI=http://localhost:4004/oauth/medisoft/callback
MEDISOFT_SCOPES=stock.read schedule.read

# ---------- In-house DB connector (local PostgreSQL = "Hospital C pharmacy") ----------
CONNECTOR_PG_URL=postgresql://pharmacy:pharmacy@localhost:5432/hospital_c
CONNECTOR_INGEST_URL=http://localhost:4004/ingest
CONNECTOR_SYNC_INTERVAL_SEC=900
# Pairing codes are issued by CAP at runtime; this only salts them
CONNECTOR_PAIRING_SECRET=change-me-random-32-chars

# ---------- Matching service (Python + OR-Tools) ----------
MATCHER_URL=http://localhost:5001
MATCHER_TIMEOUT_MS=10000

# ---------- Routing and weather (free) ----------
# openrouteservice.org -> sign up -> Dashboard -> request a free token
ORS_API_KEY=
ORS_BASE_URL=https://api.openrouteservice.org
# Open-Meteo needs no key
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast

# ---------- LLM ----------
# Preferred: SAP AI Core generative AI hub (credentials via cds bind / service key file)
LLM_PROVIDER=aicore                  # aicore | none
AICORE_RESOURCE_GROUP=default
AICORE_MODEL_NAME=                   # a model your generative AI hub trial lists, e.g. gpt-4o-mini
AICORE_SERVICE_KEY_PATH=./aicore-key.json   # downloaded service key; git-ignored
# If LLM_PROVIDER=none, the app must still work (template explanations, manual flag entry)

# ---------- Alerts ----------
ALERT_NOTIFICATION_ENABLED=false     # true once SAP Alert Notification is bound
ALERT_EMAIL_TO=

# ---------- Business rules (defaults, overridable per hospital) ----------
DEFAULT_SAFETY_MARGIN_PCT=20
DEFAULT_COVER_WINDOW_DAYS=14
EXPIRY_BUFFER_DAYS=7
NEAR_EXPIRY_DAYS=60
SUPPLIER_RESPONSE_TIMEOUT_MIN=30
SYNC_INTERVAL_SEC=900
STALE_FEED_MINUTES=60
COLD_CHAIN_MIN_C=2
COLD_CHAIN_MAX_C=8
PATIENT_REF_HASH_SALT=change-me-random-32-chars

# ---------- Delivery partner simulator ----------
SIM_TELEMETRY_INTERVAL_SEC=5
SIM_EXCURSION_ENABLED=true           # one shipment deliberately goes out of range
