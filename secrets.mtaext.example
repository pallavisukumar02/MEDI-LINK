# Copy to secrets.mtaext (git-ignored), fill in random values (openssl rand -hex 16), then:
#   cf deploy mta_archives/medilink_1.0.0.mtar -e secrets.mtaext
# The SAME client secret and salt must go to medilink-srv and medilink-medisoft.
_schema-version: "3.2"
ID: medilink.secrets
extends: medilink

modules:
  - name: medilink-srv
    properties:
      MEDISOFT_OAUTH_CLIENT_ID: medilink-client
      MEDISOFT_OAUTH_CLIENT_SECRET: change-me-random-32-chars
      PATIENT_REF_HASH_SALT: change-me-random-32-chars
      CONNECTOR_PAIRING_SECRET: change-me-random-32-chars
      TOKEN_STORE_KEY: change-me-random-32-chars
      MATCHER_TOKEN: change-me-random-32-chars
      SAP_API_HUB_KEY: ""            # optional: api.sap.com key; empty = offline fixture
      ORS_API_KEY: ""                # optional: openrouteservice.org token; empty = Haversine
      # optional switches (docs/SAP_GO_LIVE.md Part 6); check GET /health/integrations after each:
      # APPROVAL_MODE: bpa
      # BPA_API_URL: ""
      # BPA_DEFINITION_ID: ""
      # BPA_TOKEN_URL: ""
      # BPA_CLIENT_ID: ""
      # BPA_CLIENT_SECRET: ""
      # LLM_PROVIDER: aicore
      # AICORE_MODEL_NAME: ""
      # ALERT_NOTIFICATION_ENABLED: true
      # ALERT_EMAIL_TO: ""
  - name: medilink-matcher
    properties:
      MATCHER_TOKEN: change-me-random-32-chars   # same value as above
      ORS_API_KEY: ""
  - name: medilink-medisoft
    properties:
      MEDISOFT_OAUTH_CLIENT_ID: medilink-client
      MEDISOFT_OAUTH_CLIENT_SECRET: change-me-random-32-chars   # same as medilink-srv
      PATIENT_REF_HASH_SALT: change-me-random-32-chars          # same as medilink-srv
